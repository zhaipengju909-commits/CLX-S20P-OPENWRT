#!/bin/sh
# CLX S20P: first-boot defaults. Runs once, then this file is removed (OpenWrt uci-defaults).
# Runs on the first boot after a flash (also when settings are kept; every step below is safe to repeat).
. /lib/functions.sh

# 1) Data partition p7 -> /mnt/data.
#    Stock first boot detects p7 but leaves the entry DISABLED (enabled '0', target /mnt/mmcblk0p7), so the disk is
#    never mounted, and mounting it by hand through a UI may offer to format it.
#    The entry is matched by DEVICE (not UUID), so it keeps working after the partition is re-formatted.
#    Nothing is ever formatted here: a partition without a filesystem is left alone.
if [ -b /dev/mmcblk0p7 ] && [ -n "$(blkid -s TYPE -o value /dev/mmcblk0p7 2>/dev/null)" ]; then
	[ -s /etc/config/fstab ] || block detect > /etc/config/fstab 2>/dev/null
	P7_UUID="$(blkid -s UUID -o value /dev/mmcblk0p7 2>/dev/null)"
	config_load fstab
	clx_drop_p7() {
		local dev uuid
		config_get dev "$1" device
		config_get uuid "$1" uuid
		if [ "$(basename "${dev:-}")" = "mmcblk0p7" ] || { [ -n "$P7_UUID" ] && [ "$uuid" = "$P7_UUID" ]; }; then
			uci -q delete "fstab.$1"
		fi
	}
	config_foreach clx_drop_p7 mount
	sec="$(uci add fstab mount)"
	uci set "fstab.$sec.device=/dev/mmcblk0p7"
	uci set "fstab.$sec.target=/mnt/data"
	uci set "fstab.$sec.enabled=1"
	uci commit fstab
fi

# 2) Flow offloading, full-cone NAT and BBR are NOT written here any more: luci-app-turboacc owns them
#    (Network -> Turbo ACC Center). Its shipped /etc/config/turboacc turns software + hardware offloading, IPv4
#    full-cone and BBR on and IPv6 full-cone off, and its init script applies them to /etc/config/firewall at every boot.
#    Writing the same options from two places would make them fight, so only the service is enabled here.
if [ -x /etc/init.d/turboacc ]; then
	/etc/init.d/turboacc enable
fi

# 3) UPnP/NAT-PMP service on by default (stock default is off). secure_mode stays on.
uci -q set upnpd.config.enabled='1'
uci -q commit upnpd

# 4) SSH (dropbear) listens on the LAN interface only (by interface name, so it follows a changed LAN address).
#    Password login is left on: other people flashing this image have no key yet.
uci -q set dropbear.@dropbear[0].Interface='lan'
uci -q commit dropbear

# 5) WAN side: drop the stock accept rules that serve no purpose on a router without a VPN server (ping, IPsec ESP,
#    ISAKMP). The wan zone still rejects all other incoming traffic. DHCP renew, IGMP (IPTV), DHCPv6 and the ICMPv6
#    rules IPv6 needs are kept, because turning them off can break a DHCP-WAN or IPTV setup.
clx_off_wan_rule() {
	local name
	config_get name "$1" name
	case "$name" in
	Allow-Ping|Allow-IPSec-ESP|Allow-ISAKMP) uci -q set "firewall.$1.enabled=0" ;;
	esac
}
config_load firewall
config_foreach clx_off_wan_rule rule
uci -q commit firewall

# 6) iStore packages are built for architecture aarch64_generic; apk only accepts it if it is listed here.
grep -qx aarch64_generic /etc/apk/arch 2>/dev/null || echo aarch64_generic >> /etc/apk/arch

exit 0
